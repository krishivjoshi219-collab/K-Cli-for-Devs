[5.328, "o", "\u001b[38;2;68;71;90m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;139;148;158m@@ -14,6 +14,28 @@ class TokenBucketLimiter:\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;255;85;85m-    def allow_request(self, key: str) -> bool:\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;255;85;85m-        # Slow sequential in-memory lock\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;255;85;85m-        with self.lock:\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;255;85;85m-            return self._consume_token(key)\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+    async def allow_request(self, key: str) -> bool:\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+        \"\"\"Atomic Token Bucket with distributed Redis Lua & zero-lock memory fallback.\"\"\"\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+        try:\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+            res = await self.redis.evalsha(self._lua_sha, 1, key, self.capacity, self.rate)\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+            return bool(res)\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+        except (ConnectionError, TimeoutError):\u001b[0m\r\n\u001b[38;2;68;71;90m\u2502\u001b[0m \u001b[38;2;80;250;123m+            return self._local_fast_lru_fallback(key)\u001b[0m\r\n\u001b[38;2;68;71;90m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\r\n"]
