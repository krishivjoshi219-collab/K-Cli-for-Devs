# Optional cloud providers. Never commit a real value.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Any OpenAI-compatible gateway or self-hosted server (vLLM, LiteLLM, LM Studio,
# Together, Groq, etc.). Use with: --provider openai-compatible --base-url "$KCLI_BASE_URL"
KCLI_API_KEY=
KCLI_BASE_URL=
KCLI_PROVIDER=openai-compatible

# Local model runtime
OLLAMA_HOST=http://localhost:11434
KCLI_MOCK_MODE=false

# Only needed by private model publishing/training scripts.
HF_TOKEN=
